<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="robot_gripper" params="gripper_span">
    <link name="gripper_palm">
      <visual><origin xyz="0.045 0 0"/><geometry><box size="0.09 0.09 0.065"/></geometry><material name="gripper_gray"><color rgba="0.48 0.52 0.58 1"/></material></visual>
      <collision><origin xyz="0.045 0 0"/><geometry><box size="0.09 0.09 0.065"/></geometry></collision>
      <inertial><origin xyz="0.045 0 0"/><mass value="0.3"/><inertia ixx="0.000308" ixy="0" ixz="0" iyy="0.000308" iyz="0" izz="0.000405"/></inertial>
    </link>
    <joint name="wrist_to_gripper" type="fixed"><parent link="wrist_link"/><child link="gripper_palm"/><origin xyz="0.07 0 0"/></joint>
    <xacro:property name="finger_thickness" value="0.014"/>
    <xacro:property name="finger_travel" value="0.045"/>
    <xacro:property name="finger_offset" value="${(gripper_span + finger_thickness)/2.0}"/>
    <link name="left_finger">
      <visual><origin xyz="0.055 0 0"/><geometry><box size="0.11 ${finger_thickness} 0.055"/></geometry><material name="finger_left"><color rgba="0.18 0.22 0.28 1"/></material></visual>
      <collision><origin xyz="0.055 0 0"/><geometry><box size="0.11 ${finger_thickness} 0.055"/></geometry></collision>
      <inertial><origin xyz="0.055 0 0"/><mass value="0.10"/><inertia ixx="0.000026" ixy="0" ixz="0" iyy="0.000126" iyz="0" izz="0.000103"/></inertial>
    </link>
    <link name="right_finger">
      <visual><origin xyz="0.055 0 0"/><geometry><box size="0.11 ${finger_thickness} 0.055"/></geometry><material name="finger_right"><color rgba="0.18 0.22 0.28 1"/></material></visual>
      <collision><origin xyz="0.055 0 0"/><geometry><box size="0.11 ${finger_thickness} 0.055"/></geometry></collision>
      <inertial><origin xyz="0.055 0 0"/><mass value="0.10"/><inertia ixx="0.000026" ixy="0" ixz="0" iyy="0.000126" iyz="0" izz="0.000103"/></inertial>
    </link>
    <joint name="left_finger_slide" type="prismatic"><parent link="gripper_palm"/><child link="left_finger"/><origin xyz="0.09 ${finger_offset} 0"/><axis xyz="0 -1 0"/><limit lower="0" upper="${finger_travel}" effort="35" velocity="0.08"/></joint>
    <joint name="right_finger_slide" type="prismatic"><parent link="gripper_palm"/><child link="right_finger"/><origin xyz="0.09 ${-finger_offset} 0"/><axis xyz="0 1 0"/><limit lower="0" upper="${finger_travel}" effort="35" velocity="0.08"/></joint>
  </xacro:macro>
</robot>
