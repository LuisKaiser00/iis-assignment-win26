<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="arm_segment" params="name length radius mass rgba">
    <link name="${name}">
      <visual><origin xyz="${length/2} 0 0" rpy="0 1.5707963267948966 0"/><geometry><cylinder radius="${radius}" length="${length}"/></geometry><material name="${name}_color"><color rgba="${rgba}"/></material></visual>
      <collision><origin xyz="${length/2} 0 0" rpy="0 1.5707963267948966 0"/><geometry><cylinder radius="${radius}" length="${length}"/></geometry></collision>
      <inertial><origin xyz="${length/2} 0 0"/><mass value="${mass}"/><inertia ixx="${mass*radius*radius/2}" ixy="0" ixz="0" iyy="${mass*(3*radius*radius + length*length)/12}" iyz="0" izz="${mass*(3*radius*radius + length*length)/12}"/></inertial>
    </link>
  </xacro:macro>
  <xacro:macro name="robot_arm" params="base_height link1_length link2_length">
    <xacro:arm_segment name="upper_arm" length="${link1_length}" radius="0.045" mass="1.6" rgba="0.15 0.40 0.78 1"/>
    <xacro:arm_segment name="forearm" length="${link2_length}" radius="0.036" mass="1.1" rgba="0.23 0.62 0.80 1"/>
    <link name="wrist_link">
      <visual><origin xyz="0.035 0 0"/><geometry><box size="0.07 0.08 0.08"/></geometry><material name="wrist_dark"><color rgba="0.19 0.22 0.28 1"/></material></visual>
      <collision><origin xyz="0.035 0 0"/><geometry><box size="0.07 0.08 0.08"/></geometry></collision>
      <inertial><origin xyz="0.035 0 0"/><mass value="0.35"/><inertia ixx="0.00037" ixy="0" ixz="0" iyy="0.000285" iyz="0" izz="0.000285"/></inertial>
    </link>
    <joint name="shoulder_pitch" type="revolute">
      <parent link="base_link"/><child link="upper_arm"/><origin xyz="0 0 ${base_height}"/><axis xyz="0 1 0"/><limit lower="-2.5" upper="2.5" effort="55" velocity="1.5"/><dynamics damping="0.08" friction="0.02"/>
    </joint>
    <joint name="elbow_pitch" type="revolute">
      <parent link="upper_arm"/><child link="forearm"/><origin xyz="${link1_length} 0 0"/><axis xyz="0 1 0"/><limit lower="-2.8" upper="2.8" effort="35" velocity="1.5"/><dynamics damping="0.06" friction="0.02"/>
    </joint>
    <joint name="wrist_pitch" type="revolute">
      <parent link="forearm"/><child link="wrist_link"/><origin xyz="${link2_length} 0 0"/><axis xyz="0 1 0"/><limit lower="-2.5" upper="2.5" effort="12" velocity="2.0"/><dynamics damping="0.03" friction="0.01"/>
    </joint>
  </xacro:macro>
</robot>
