<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="robot_base" params="base_radius base_height">
    <link name="base_link">
      <visual><origin xyz="0 0 ${base_height/2}"/><geometry><cylinder radius="${base_radius}" length="${base_height}"/></geometry><material name="base_gray"><color rgba="0.35 0.39 0.44 1"/></material></visual>
      <collision><origin xyz="0 0 ${base_height/2}"/><geometry><cylinder radius="${base_radius}" length="${base_height}"/></geometry></collision>
      <inertial><origin xyz="0 0 ${base_height/2}"/><mass value="12.0"/><inertia ixx="${12.0*(3*base_radius*base_radius + base_height*base_height)/12.0}" ixy="0" ixz="0" iyy="${12.0*(3*base_radius*base_radius + base_height*base_height)/12.0}" iyz="0" izz="${12.0*base_radius*base_radius/2.0}"/></inertial>
    </link>
  </xacro:macro>
</robot>
