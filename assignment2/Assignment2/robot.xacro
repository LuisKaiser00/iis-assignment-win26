<?xml version="1.0"?>
<robot name="eva_drink_assistant" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Design parameters, change these to adapt the robot. Units: metres. -->
  <xacro:arg name="base_radius" default="0.18"/>
  <xacro:arg name="base_height" default="0.72"/>
  <xacro:arg name="link1_length" default="0.48"/>
  <xacro:arg name="link2_length" default="0.42"/>
  <xacro:arg name="gripper_span" default="0.14"/>
  <xacro:property name="base_radius" value="$(arg base_radius)"/>
  <xacro:property name="base_height" value="$(arg base_height)"/>
  <xacro:property name="link1_length" value="$(arg link1_length)"/>
  <xacro:property name="link2_length" value="$(arg link2_length)"/>
  <xacro:property name="gripper_span" value="$(arg gripper_span)"/>
  <xacro:include filename="base.xacro"/>
  <xacro:include filename="arm.xacro"/>
  <xacro:include filename="gripper.xacro"/>
  <xacro:robot_base base_radius="${base_radius}" base_height="${base_height}"/>
  <xacro:robot_arm base_height="${base_height}" link1_length="${link1_length}" link2_length="${link2_length}"/>
  <xacro:robot_gripper gripper_span="${gripper_span}"/>
</robot>
